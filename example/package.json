{
  "name": "react-native-piwik-pro-sdk-example",
  "description": "Example app for react-native-piwik-pro-sdk",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator='iPhone 17'",
    "ios:fresh": "xcrun simctl terminate booted com.example.reactnativepiwikprosdk || true && xcrun simctl uninstall booted com.example.reactnativepiwikprosdk || true && react-native run-ios --simulator='iPhone 17' --no-packager",
    "start": "react-native start",
    "start:clean": "react-native start --reset-cache",
    "typescript": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@react-navigation/native": "^7.2.0",
    "@react-navigation/native-stack": "^7.14.7",
    "@react-navigation/stack": "^7.8.7",
    "@reduxjs/toolkit": "^2.11.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.84.1",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-vector-icons": "^10.3.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/runtime": "^7.29.2",
    "@react-native-community/cli": "20.1.3",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@types/react": "^19.2.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "metro-minify-terser": "0.84.2",
    "typescript": "~6.0.2"
  }
}
