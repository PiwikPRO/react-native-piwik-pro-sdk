{
  "name": "react-native-piwik-pro-sdk-example",
  "description": "Example app for react-native-piwik-pro-sdk",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator='iPhone 17'",
    "ios:fresh": "xcrun simctl terminate booted com.example.reactnativepiwikprosdk || true && xcrun simctl uninstall booted com.example.reactnativepiwikprosdk || true && react-native run-ios --simulator='iPhone 17' --no-packager",
    "start": "react-native start",
    "start:clean": "react-native start --reset-cache",
    "typescript": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@react-navigation/stack": "^7.10.24",
    "@reduxjs/toolkit": "^2.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-vector-icons": "^10.3.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@types/react": "^19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "metro-minify-terser": "0.87.0",
    "typescript": "~6.0.3"
  }
}
